DATABASE_URL=postgres://cs:cs@127.0.0.1:55434/content_studio
DATABASE_URL_TEST=postgres://cs:cs@127.0.0.1:55434/content_studio_test
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret
BETTER_AUTH_URL=http://localhost:3003
# Vide/absent = signup ouvert (par défaut, pratique en dev local mono-utilisateur).
# 1 (ou true) = signup refusé pour tout le monde SAUF le tout premier compte
# (bootstrap) si la base est encore vide. À poser après avoir créé ton compte
# owner, systématiquement si l'instance est exposée au-delà de ta machine —
# voir README, section Sécurité / déploiement.
DISABLE_SIGNUP=

# ─── Déploiement (docker compose) ───────────────────────────────────────────
# Ces variables ne servent qu'à `docker compose` : elles sont lues depuis un
# fichier `.env` (jamais versionné, cf. .gitignore) posé à côté du compose.
# Vides/absentes = valeurs de dev local ci-dessus.
#
# APP_PORT=3003            # port publié sur 127.0.0.1 côté hôte
# POSTGRES_PORT=55434      # idem pour postgres
# POSTGRES_USER=cs
# POSTGRES_PASSWORD=cs     # à changer sur tout déploiement partagé
# POSTGRES_DB=content_studio
